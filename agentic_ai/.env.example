# Copy to agentic_ai/.env to override defaults. Never add secrets here.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:4b-instruct
OLLAMA_TIMEOUT_SECONDS=120
FOOD_VALIDATION_ATTEMPTS=2
FOOD_MAX_INPUT_CHARS=4000

# Milestone 2: only live USDA mode needs a key. Snapshot mode needs none.
USDA_API_KEY=
USDA_TIMEOUT_SECONDS=20
USDA_RETRIES=1

# Optional Milestone 3 bounds; see ORCHESTRATION.md for all defaults and hard caps.
# NUTRIAI_ORCH_MAX_SESSIONS=20
# NUTRIAI_ORCH_TTL_SECONDS=1800
# NUTRIAI_ORCH_MAX_STORE_BYTES=16777216
